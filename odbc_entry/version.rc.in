#include <winresrc.h>

VS_VERSION_INFO VERSIONINFO
  FILEVERSION    @WARP_ODBC_VERSION_MAJOR@,@WARP_ODBC_VERSION_MINOR@,@WARP_ODBC_VERSION_PATCH@,@WARP_ODBC_VERSION_TWEAK@
  PRODUCTVERSION @WARP_ODBC_VERSION_MAJOR@,@WARP_ODBC_VERSION_MINOR@,@WARP_ODBC_VERSION_PATCH@,@WARP_ODBC_VERSION_TWEAK@
  FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
  FILEFLAGS      0x0L
  FILEOS         VOS_NT_WINDOWS32
  FILETYPE       VFT_DLL
  FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "GizmoData LLC"
      VALUE "FileDescription",  "@WARP_ODBC_PRODUCT_NAME@"
      VALUE "FileVersion",      "@WARP_ODBC_VERSION_MAJOR@.@WARP_ODBC_VERSION_MINOR@.@WARP_ODBC_VERSION_PATCH@.@WARP_ODBC_VERSION_TWEAK@"
      VALUE "LegalCopyright",   "Copyright (C) 2026 GizmoData LLC"
      VALUE "OriginalFilename", "@WARP_ODBC_LIBRARY_NAME@.dll"
      VALUE "ProductName",      "@WARP_ODBC_PRODUCT_NAME@"
      VALUE "ProductVersion",   "@WARP_ODBC_VERSION_MAJOR@.@WARP_ODBC_VERSION_MINOR@.@WARP_ODBC_VERSION_PATCH@.@WARP_ODBC_VERSION_TWEAK@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
